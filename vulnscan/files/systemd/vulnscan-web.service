[Unit]
Description=vulnscan dashboard (port 8080)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 -m http.server 8080 --directory /opt/vulnscan/www --bind 0.0.0.0
Restart=always
RestartSec=5
User=vulnscan-web
Group=vulnscan-web
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
